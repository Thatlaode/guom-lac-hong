# Cấu hình máy chủ Gươm Lạc Hồng (chép thành /etc/guom-lac-hong.env)
PORT=8080
# Sau nginx thì chỉ nghe trong máy; chạy thẳng không có nginx thì đổi 0.0.0.0
HOST=127.0.0.1
# Dữ liệu lâu dài (cấu hình Admin, bản cân bằng, bậc hạng, thống kê) — KHÔNG nằm trong thư mục mã
DATA_DIR=/var/lib/guom-lac-hong
# Mã Admin: đặt chuỗi dài khó đoán. Bỏ trống → máy chủ tự sinh và lưu ở DATA_DIR/admin-key.txt
ADMIN_KEY=
# Giới hạn chống quá tải
MAX_PER_IP=20
MAX_CONN=300
NODE_ENV=production
